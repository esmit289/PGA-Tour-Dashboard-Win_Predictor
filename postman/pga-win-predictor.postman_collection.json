{
  "info": {
    "name": "PGA Tour Win Predictor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://esmit289--pga-win-predictor-fastapi-app.modal.run"
    }
  ],
  "item": [
    {
      "name": "GET /info (health + artifact description)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/info"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('has metadata and feature_bounds', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('metadata');",
              "    pm.expect(json).to.have.property('feature_bounds');",
              "    pm.expect(json.metadata).to.have.property('sklearn_version');",
              "    pm.expect(json.metadata).to.have.property('built_at');",
              "    pm.expect(json.metadata).to.have.property('steps');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /predict (valid input -> 200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scoring_avg\": 68.804,\n  \"driving_distance\": 324.91,\n  \"driving_accuracy_pct\": 72.704,\n  \"gir_pct\": 72.192,\n  \"putting_avg\": 1.687,\n  \"putts_per_round\": 27.717,\n  \"scrambling_pct\": 68.234,\n  \"sand_save_pct\": 66.972,\n  \"sg_total\": 2.123,\n  \"sg_off_the_tee\": 0.95,\n  \"sg_approach\": 1.13,\n  \"sg_around_green\": 0.539,\n  \"sg_putting\": 0.891,\n  \"birdie_avg\": 4.708,\n  \"birdie_or_better_pct\": 26.547,\n  \"bogey_avoidance_pct\": 11.201,\n  \"season\": 2024\n}"
        },
        "url": "{{base_url}}/predict"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('response has prediction fields', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('predicted_win_season');",
              "    pm.expect(json).to.have.property('win_probability');",
              "    pm.expect(json.win_probability).to.be.within(0, 1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /predict (out-of-bounds input -> 422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scoring_avg\": 1074.865,\n  \"driving_distance\": 324.91,\n  \"driving_accuracy_pct\": 72.704,\n  \"gir_pct\": 72.192,\n  \"putting_avg\": 1.687,\n  \"putts_per_round\": 27.717,\n  \"scrambling_pct\": 68.234,\n  \"sand_save_pct\": 66.972,\n  \"sg_total\": 2.123,\n  \"sg_off_the_tee\": 0.95,\n  \"sg_approach\": 1.13,\n  \"sg_around_green\": 0.539,\n  \"sg_putting\": 0.891,\n  \"birdie_avg\": 4.708,\n  \"birdie_or_better_pct\": 26.547,\n  \"bogey_avoidance_pct\": 11.201,\n  \"season\": 2024\n}"
        },
        "url": "{{base_url}}/predict"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}